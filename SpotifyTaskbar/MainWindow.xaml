<Window x:Class="SpotifyTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotifyTaskbar"
        Width="320" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open Spotify" Click="OpenSpotify_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Same look as an active taskbar button: faint fill + thin light outline -->
    <Border Margin="0,4" Padding="4,0" CornerRadius="6"
            Background="#0FFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Width="36" Height="36" CornerRadius="4" Background="#33FFFFFF" ClipToBounds="True"
                Cursor="Hand" MouseLeftButtonUp="Art_Click">
            <Grid>
                <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                           Foreground="#AAFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="Art" Stretch="UniformToFill">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,36,36" RadiusX="4" RadiusY="4"/>
                    </Image.Clip>
                </Image>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Spotify" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ArtistText" Text="Not playing" Foreground="#B3FFFFFF" FontSize="11.5"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous" Click="Prev_Click"/>
            <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play/Pause" Click="Play_Click" FontSize="16"/>
            <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next" Click="Next_Click"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
