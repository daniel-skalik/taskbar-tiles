<UserControl x:Class="TaskbarTiles.Host.UI.TileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Border x:Name="Root" CornerRadius="6" BorderThickness="1" Padding="6,0"
            Background="{DynamicResource TileFill}" BorderBrush="{DynamicResource TileOutline}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TileState.Canvas under everything, edge to edge like the progress bar, with hard pixel edges. -->
            <Grid x:Name="SceneClip" Grid.ColumnSpan="3" Margin="-6,0" IsHitTestVisible="False">
                <Image x:Name="Scene" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- TileState.Sparkline across the whole tile behind the icon and text, edge to edge like the scene. -->
            <Grid x:Name="SparkClip" Grid.ColumnSpan="3" Margin="-6,0" IsHitTestVisible="False">
                <Canvas x:Name="SparkHost" Visibility="Collapsed">
                    <Polygon x:Name="SparkArea" Fill="#337AA2F7"/>
                    <Polyline x:Name="Spark" StrokeThickness="1.5" Stroke="#B37AA2F7" StrokeLineJoin="Round"/>
                </Canvas>
            </Grid>

            <Grid x:Name="IconHost" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                <Border x:Name="IconBackground" CornerRadius="5"/>
                <TextBlock x:Name="IconGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="Picture" Stretch="UniformToFill">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,28,28" RadiusX="4" RadiusY="4"/>
                    </Image.Clip>
                </Image>
                <Border x:Name="PictureTint" Visibility="Collapsed"/>
            </Grid>

            <StackPanel x:Name="TextPanel" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                <TextBlock x:Name="TitleText" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TileForeground}"/>
                <TextBlock x:Name="SubtitleText" FontSize="11.5" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TileDim}"/>
            </StackPanel>

            <StackPanel x:Name="ExtrasPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal"/>
            </StackPanel>

            <!-- Spans the padding to both edges (margin set with the padding); clipped to the inner rounded corners in code. -->
            <Grid x:Name="ProgressClip" Grid.ColumnSpan="3" Margin="-6,0" IsHitTestVisible="False">
                <!-- TileState.ProgressMark: where the bar should be by now, a dim bar under the real one. -->
                <Grid x:Name="PaceTrack" Height="2" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PaceDone" Width="0*"/>
                        <ColumnDefinition x:Name="PaceLeft" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PaceFill" Background="#4C7CE0" Opacity="0.4"/>
                </Grid>
                <!-- TileState.ProgressForecast: where the bar will be at the end, dashed from the bar's end. -->
                <Grid x:Name="ForecastTrack" Height="2" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ForecastBefore" Width="0*"/>
                        <ColumnDefinition x:Name="ForecastSpan" Width="0*"/>
                        <ColumnDefinition x:Name="ForecastAfter" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ForecastFill" Grid.Column="1"/>
                </Grid>
                <Grid x:Name="ProgressTrack" Height="2" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProgressDone" Width="0*"/>
                        <ColumnDefinition x:Name="ProgressLeft" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ProgressFill" Background="#4C7CE0"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
